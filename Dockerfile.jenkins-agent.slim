# Use the base image
FROM jenkins/inbound-agent:latest-jdk21

# Set non-interactive mode for tzdata
ENV DEBIAN_FRONTEND=noninteractive \
  TZ=Pacific/Auckland

# Use bash with pipefail for safer RUN steps
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# switch to root user
USER root

# Tool versions in one place
ARG PWSH_VERSION=7.6.4
ARG TERRAFORM_VERSION=1.14.9*
ARG NODE_MAJOR=22
ARG K8S_MINOR=v1.34

# Skip package docs and man pages; nothing in CI reads them
RUN printf '%s\n' \
  'path-exclude /usr/share/doc/*' \
  'path-exclude /usr/share/man/*' \
  'path-exclude /usr/share/info/*' \
  'path-exclude /usr/share/groff/*' \
  'path-exclude /usr/share/lintian/*' \
  > /etc/dpkg/dpkg.cfg.d/01-nodoc

# All apt work in one layer: third-party repos, then a single install, then cleanup.
# Split across layers the cleanup reclaims nothing, because the files stay in the earlier layer.
RUN set -eux && \
  rm -rf /var/lib/apt/lists/* && \
  apt-get update && \
  apt-get install -y --no-install-recommends \
  ca-certificates curl gnupg lsb-release && \
  install -m 0755 -d /etc/apt/keyrings && \
  # HashiCorp repo, shared by Packer and Terraform
  curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg && \
  echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" > /etc/apt/sources.list.d/hashicorp.list && \
  # Kubernetes repo
  curl -fsSL "https://pkgs.k8s.io/core:/stable:/${K8S_MINOR}/deb/Release.key" | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg && \
  echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/${K8S_MINOR}/deb/ /" > /etc/apt/sources.list.d/kubernetes.list && \
  # Docker repo
  curl -fsSL "https://download.docker.com/linux/$(. /etc/os-release && echo "$ID")/gpg" -o /etc/apt/keyrings/docker.asc && \
  chmod a+r /etc/apt/keyrings/docker.asc && \
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$(. /etc/os-release && echo "$ID") $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list && \
  # Node.js repo, added directly so the NodeSource setup script's own apt update is skipped
  curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
  echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" > /etc/apt/sources.list.d/nodesource.list && \
  apt-get update && \
  apt-get install -y --no-install-recommends \
  sudo \
  vim \
  less \
  procps \
  iproute2 \
  tcpdump \
  netcat-openbsd \
  iputils-ping \
  dnsutils \
  unzip \
  zip \
  traceroute \
  htop \
  git \
  jq \
  wget \
  bash-completion \
  python3 \
  python3-pip \
  nodejs \
  packer \
  "terraform=${TERRAFORM_VERSION}" \
  kubectl \
  docker-ce-cli \
  docker-buildx-plugin \
  docker-compose-plugin && \
  # Buildah keeps its recommends: they are the rootless helpers (fuse-overlayfs, slirp4netns)
  apt-get install -y buildah && \
  ln -sf /usr/bin/python3 /usr/bin/python && \
  terraform -install-autocomplete && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/* /var/cache/apt/* /tmp/*

# Install PowerShell
RUN set -eux && \
  curl -fsSL "https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/powershell_${PWSH_VERSION}-1.deb_amd64.deb" -o /tmp/powershell.deb && \
  apt-get update && \
  # apt installs the local .deb and pulls its dependencies, so no dpkg -i then install -f dance
  apt-get install -y --no-install-recommends /tmp/powershell.deb && \
  pwsh -Command "Install-Module -Name Powershell-Yaml -Force -Scope AllUsers" && \
  rm -f /tmp/powershell.deb && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/* /var/cache/apt/* /root/.cache /tmp/*

# Install Python packages
RUN set -eux && \
  pip3 install --no-cache-dir --break-system-packages yq ansible pywinrm && \
  rm -rf /root/.cache /tmp/*

# Install CDKTF CLI
RUN set -eux && \
  npm install --global cdktf-cli@latest cdktn-cli@latest && \
  npm cache clean --force && \
  rm -rf /root/.npm /tmp/*

# Install AWS CLI and Helm
RUN set -eux && \
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip && \
  unzip -q /tmp/awscliv2.zip -d /tmp && \
  /tmp/aws/install && \
  curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash && \
  rm -rf /tmp/awscliv2.zip /tmp/aws /root/.cache /tmp/*

# Agent configuration: sudoers, SSH defaults and shell aliases
RUN set -eux && \
  echo "jenkins ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers && \
  printf '%s\n' \
  'PubkeyAcceptedKeyTypes +ssh-rsa' \
  'HostkeyAlgorithms +ssh-rsa' \
  'StrictHostKeyChecking no' \
  >> /etc/ssh/ssh_config && \
  echo "alias ll='ls -halF'" >> /root/.bashrc && \
  echo "starbuggx-jenkins-agent" >> /root/starbuggx-jenkins-agent && \
  echo "alias ll='ls -halF'" >> /home/jenkins/.bashrc

# Buildah settings that work when the agent itself runs unprivileged
ENV STORAGE_DRIVER=vfs \
  BUILDAH_ISOLATION=chroot

# Switch back to the jenkins user
USER jenkins
