# Use the base image
FROM jenkins/inbound-agent:latest-jdk21

# Set non-interactive mode for tzdata
ENV DEBIAN_FRONTEND=noninteractive \
  TZ=Pacific/Auckland

# Use bash with pipefail for safer RUN steps
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# switch to root user
USER root

# Update system and install essential packages
RUN set -eux && \
  rm -rf /var/lib/apt/lists/* && \
  apt-get update && \
  apt-get install -y --no-install-recommends \
  ca-certificates \
  gnupg \
  sudo \
  vim \
  less \
  procps \
  iproute2 \
  tcpdump \
  netcat-openbsd \
  iputils-ping \
  dnsutils \
  unzip \
  zip \
  lsb-release \
  traceroute \
  htop \
  curl \
  git \
  jq \
  wget \
  bash-completion \
  python3 \
  python3-pip && \
  ln -sf /usr/bin/python3 /usr/bin/python && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/*

# Install Python packages
RUN pip3 install --break-system-packages yq ansible pywinrm

# Install PowerShell
RUN PWSH_VERSION=7.6.1 && \
  curl -fsSL "https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/powershell_${PWSH_VERSION}-1.deb_amd64.deb" -o /tmp/powershell.deb && \
  dpkg -i /tmp/powershell.deb; \
  apt-get update && \
  apt-get install -f -y && \
  rm /tmp/powershell.deb && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/* && \
  pwsh -Command "Install-Module -Name Powershell-Yaml -Force -Scope AllUsers"

# Install Node.js 22
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
  apt-get update && \
  apt-get install -y nodejs && \
  rm -rf /var/lib/apt/lists/*

# Install AWS CLI
RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" && \
  unzip awscliv2.zip && ./aws/install && \
  rm -rf awscliv2.zip aws

# Install Packer and Terraform, which share the HashiCorp repo
RUN curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg && \
  echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/hashicorp.list && \
  apt-get update && \
  apt-get install -y packer terraform=1.14.9* && \
  terraform -install-autocomplete && \
  rm -rf /var/lib/apt/lists/*

# Install Kubernetes CLI (kubectl)
RUN install -m 0755 -d /etc/apt/keyrings && \
  curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.34/deb/Release.key | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg && \
  echo 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.34/deb/ /' | \
  tee /etc/apt/sources.list.d/kubernetes.list && \
  apt-get update && apt-get install -y kubectl && \
  rm -rf /var/lib/apt/lists/*

# Install Helm from official GitHub releases
RUN curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

# Install Docker CLI
RUN install -m 0755 -d /etc/apt/keyrings && \
  curl -fsSL https://download.docker.com/linux/$(. /etc/os-release && echo "$ID")/gpg -o /etc/apt/keyrings/docker.asc && \
  chmod a+r /etc/apt/keyrings/docker.asc && \
  echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$(. /etc/os-release && echo "$ID") \
  $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
  tee /etc/apt/sources.list.d/docker.list > /dev/null && \
  apt-get update && apt-get install -y docker-ce-cli && \
  rm -rf /var/lib/apt/lists/*

# Install Buildah for daemonless image builds
# vfs and chroot are the settings that work when the agent itself runs unprivileged
ENV STORAGE_DRIVER=vfs \
  BUILDAH_ISOLATION=chroot
RUN apt-get update && apt-get install -y buildah && \
  rm -rf /var/lib/apt/lists/*

# Install CDKTF CLI
RUN npm install --global cdktf-cli@latest && \
  npm install --global cdktn-cli@latest

# Add the Jenkins user to the sudoers file; sudo comes from the essential packages above
RUN echo "jenkins ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# Set the values for SSH
RUN cat <<EOF >> /etc/ssh/ssh_config
PubkeyAcceptedKeyTypes +ssh-rsa
HostkeyAlgorithms +ssh-rsa
StrictHostKeyChecking no
EOF

# Clear installer leftovers; apt lists are already removed per-layer above
RUN rm -rf /tmp/* /var/cache/*

# Set useful aliases in .bashrc for root and jenkins
RUN echo "alias ll='ls -halF'" >> ~/.bashrc \
  && echo "starbuggx-jenkins-agent" >> ~/starbuggx-jenkins-agent

# Switch back to the jenkins user
USER jenkins

# Set the values
RUN echo "alias ll='ls -halF'" >> ~/.bashrc
