# Use the base image
FROM jenkins/inbound-agent:latest-jdk21

# Set non-interactive mode for tzdata
ENV DEBIAN_FRONTEND=noninteractive \
  TZ=Pacific/Auckland

# Use bash with pipefail for safer RUN steps
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# switch to root user
USER root

# Update system and install essential packages
RUN set -eux && \
  rm -rf /var/lib/apt/lists/* && \
  apt-get update && \
  apt-get install -y --no-install-recommends \
  ca-certificates \
  gnupg \
  sudo \
  vim \
  less \
  procps \
  iproute2 \
  tcpdump \
  netcat-openbsd \
  iputils-ping \
  dnsutils \
  unzip \
  zip \
  lsb-release \
  traceroute \
  htop \
  curl \
  git \
  jq \
  wget \
  bash-completion \
  python3 \
  python3-pip && \
  ln -sf /usr/bin/python3 /usr/bin/python && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/*

# Install Python packages. boto3/botocore pinned >=1.35.0: amazon.aws 11.x (installed below)
# is untested below that, and the aws_ssm Windows payload path misbehaves with older boto.
RUN pip3 install --break-system-packages yq ansible pywinrm 'boto3>=1.35.0' 'botocore>=1.35.0'

# The bundled ansible package pins amazon.aws 9.x (aws_ec2 inventory only). Install >=11.4.0
# to a global collections path: 10.x has the aws_ssm connection plugin but the Windows exec
# fixes (PR #2909/#3013 - the "invalid payload" failures) only landed in 11.4.0. --force so it
# upgrades over anything older; the global path takes precedence for the jenkins runtime user.
RUN ansible-galaxy collection install 'amazon.aws:>=11.4.0' 'community.aws:>=10.0.0' --force -p /usr/share/ansible/collections

# Install PowerShell
RUN PWSH_VERSION=7.6.4 && \
  curl -fsSL "https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/powershell_${PWSH_VERSION}-1.deb_amd64.deb" -o /tmp/powershell.deb && \
  dpkg -i /tmp/powershell.deb; \
  apt-get update && \
  apt-get install -f -y && \
  rm /tmp/powershell.deb && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/* && \
  pwsh -Command "Install-Module -Name Powershell-Yaml -Force -Scope AllUsers"

# Install Node.js 22
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
  apt-get update && \
  apt-get install -y nodejs && \
  rm -rf /var/lib/apt/lists/*

# Install AWS CLI
RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" && \
  unzip awscliv2.zip && ./aws/install && \
  rm -rf awscliv2.zip aws

# Install the AWS Session Manager plugin (required for the Ansible aws_ssm connection over SSM)
RUN curl -fsSL "https://s3.amazonaws.com/session-manager-downloads/plugin/latest/ubuntu_64bit/session-manager-plugin.deb" -o /tmp/session-manager-plugin.deb && \
  dpkg -i /tmp/session-manager-plugin.deb && \
  rm -f /tmp/session-manager-plugin.deb

# Install Packer
RUN curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg && \
  echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/hashicorp.list && \
  apt-get update && \
  apt-get install -y packer && \
  rm -rf /var/lib/apt/lists/*

# Install Kubernetes CLI (kubectl)
RUN install -m 0755 -d /etc/apt/keyrings && \
  curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.34/deb/Release.key | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg && \
  echo 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.34/deb/ /' | \
  tee /etc/apt/sources.list.d/kubernetes.list && \
  apt-get update && apt-get install -y kubectl && \
  rm -rf /var/lib/apt/lists/*

# Install Helm from official GitHub releases
RUN curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

# Install Docker CLI
RUN install -m 0755 -d /etc/apt/keyrings && \
  curl -fsSL https://download.docker.com/linux/$(. /etc/os-release && echo "$ID")/gpg -o /etc/apt/keyrings/docker.asc && \
  chmod a+r /etc/apt/keyrings/docker.asc && \
  echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$(. /etc/os-release && echo "$ID") \
  $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
  tee /etc/apt/sources.list.d/docker.list > /dev/null && \
  apt-get update && apt-get install -y docker-ce-cli && \
  rm -rf /var/lib/apt/lists/*

# Install CDKTF CLI and Terraform
RUN npm install --global cdktf-cli@latest && \
  npm install --global cdktn-cli@latest && \
  wget -O- https://apt.releases.hashicorp.com/gpg | \
  gpg --dearmor | \
  tee /usr/share/keyrings/hashicorp-archive-keyring.gpg > /dev/null && \
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(. /etc/os-release && echo \"${VERSION_CODENAME:-$UBUNTU_CODENAME}\") main" | \
  tee /etc/apt/sources.list.d/hashicorp.list && \
  apt-get update && \
  apt-get install -y terraform=1.14.9* && \
  terraform -install-autocomplete && \
  rm -rf /var/lib/apt/lists/*

# Add the Jenkins user to the sudoers file
RUN apt-get update && apt-get install -y sudo && echo "jenkins ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers && rm -rf /var/lib/apt/lists/*

# Set the values for SSH
RUN cat <<EOF >> /etc/ssh/ssh_config
PubkeyAcceptedKeyTypes +ssh-rsa
HostkeyAlgorithms +ssh-rsa
StrictHostKeyChecking no
EOF

#  clean up
RUN apt-get clean -y \
  && rm -rf /tmp/* /var/cache/* /var/lib/apt/lists/*

# Set useful aliases in .bashrc for root and jenkins
RUN echo "alias ll='ls -halF'" >> ~/.bashrc \
  && echo "starbuggx-jenkins-agent" >> ~/starbuggx-jenkins-agent

# Switch back to the jenkins user
USER jenkins

# Set the values
RUN echo "alias ll='ls -halF'" >> ~/.bashrc
